{
  "name": "Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  // DNS: the host resolver can be a stub that   
  // exists only in the host netns, and a VPN/tailnet exit can hijack DNS so the
  // container gets "Temporary failure resolving" from apt/pnpm and can't pull
  // images. Pin public resolvers for the container's netns. This is a runArg
  // only — it does not touch the docker.sock handling below. If the host needs
  // tailnet MagicDNS names inside the container, add the tailnet resolver
  // (e.g. 100.100.100.100) here as well, or drop these entries.
  "runArgs": [
    "--dns",
    "1.1.1.1",
    "--dns",
    "8.8.8.8"
  ],
  // common-utils and git are already baked into the base image — no need to
  // re-add them as features.
  //
  // docker-outside-of-docker: the container gets the docker CLI and talks to
  // the VM's daemon. IMPORTANT: do NOT add a runArgs/mounts entry for
  // /var/run/docker.sock — the feature mounts the host socket itself at
  // /var/run/docker-host.sock and runs a socat proxy that creates a
  // permission-fixed /var/run/docker.sock. A manual mount collides with the
  // proxy. With DevPod on the VM this yields sibling containers sharing one
  // daemon and build cache, and requires no privileged mode. The VM is the
  // isolation boundary anyway. If a container ever must be fully
  // self-contained, swap in "ghcr.io/devcontainers/features/docker-in-docker:2"
  // and add "--privileged" to runArgs.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Make mise shims and pnpm global bins visible to non-interactive shells
  // (VS Code tasks, debuggers, extension language servers); interactive bash
  // additionally gets `mise activate` + PNPM_HOME via .bashrc from setup-mise.sh.
  "remoteEnv": {
    "PNPM_HOME": "/home/vscode/.local/share/pnpm",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/.local/share/mise/shims:/home/vscode/.local/share/pnpm"
  },
  // `dotfiles` is not a valid devcontainer.json property — removed.
  // DevPod applies dotfiles natively; set once on the VM:
  //   devpod context set-options \
  //     -o DOTFILES_URL=https://github.com/<you>/dotfiles \
  //     -o DOTFILES_SCRIPT=install.sh
  // No static forwardPorts: VS Code auto-forwards ports when a service starts
  // listening in the container (see the PORTS panel). Static entries only add
  // collision risk between multiple workspaces. If an external tool ever needs
  // a port before anything listens, add it per-project, not in the template.
  "remoteUser": "vscode"
}
